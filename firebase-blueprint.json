{
  "entities": {
    "Transcription": {
      "title": "Transcription",
      "description": "A transcription of an audio recording.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The transcribed text."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who created the transcription."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the transcription was created."
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "The status of the transcription."
        },
        "archivedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the transcription was archived."
        }
      },
      "required": ["text", "userId", "createdAt", "status"]
    }
  },
  "firestore": {
    "transcriptions/{transcriptionId}": {
      "schema": "Transcription",
      "description": "Collection of transcriptions."
    }
  }
}
